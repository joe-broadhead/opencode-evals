#!/usr/bin/env node
// `evals` — the CLI. Thin: parse argv, hand to src/cli.mjs.
import { main } from "../src/cli.mjs"
import { ignoreStdioErrors } from "../src/stdio.mjs"

ignoreStdioErrors()
main(process.argv.slice(2)).catch((error) => {
  console.error(error?.stack ?? String(error))
  process.exit(1)
})
